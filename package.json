{
  "name": "lanes",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @lanes/server --filter @lanes/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @lanes/server start",
    "test": "pnpm --filter @lanes/shared --filter @lanes/server --filter @lanes/mcp test",
    "e2e": "playwright test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed": "pnpm --filter @lanes/server seed",
    "db:reset": "pnpm --filter @lanes/server db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
