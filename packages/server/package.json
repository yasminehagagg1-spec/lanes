{
  "name": "@lanes/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "LANES_DATA_DIR=../../.data-dev tsx watch --conditions=source src/index.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "LANES_DATA_DIR=../../.data-dev tsx --conditions=source src/scripts/seed.ts",
    "db:reset": "LANES_DATA_DIR=../../.data-dev tsx --conditions=source src/scripts/db-reset.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node-notifier": "^8.0.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fastify/static": "^10.1.9",
    "@lanes/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "node-notifier": "^12.1.0",
    "zod": "^4.6.7"
  }
}
